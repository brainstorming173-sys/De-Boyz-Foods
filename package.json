{
  "name": "deboyz-foods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "dev:all": "concurrently -n api,web -c green,red \"npm run dev\" \"npm run dev:client\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "db:schema": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "momo:sandbox": "node server/scripts/momo-sandbox-setup.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
