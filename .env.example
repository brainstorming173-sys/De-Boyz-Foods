# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (Neon) ----
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Seed admin (used by npm run seed) ----
ADMIN_NAME=De-Boyz Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Google sign-in ----
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Resend ----
RESEND_API_KEY=
EMAIL_FROM=De-Boyz Foods <onboarding@resend.dev>
# Who gets the "New order" email (comma-separated). Defaults to ADMIN_EMAIL if left empty.
ORDER_NOTIFY_EMAIL=

# ---- MTN MoMo (direct, Collections API "Request to Pay") ----
# mock       = local dev, no real prompt (auto-approves after 8 seconds)
# sandbox    = MTN's test environment (run: npm run momo:sandbox to get API user + key)
# production = live money, after MTN approves your business
MOMO_ENV=mock
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# Production only. Must match what's registered in the MTN portal:
MOMO_CALLBACK_URL=
# Production only, if MTN gives you different values:
# MOMO_BASE_URL=https://proxy.momoapi.mtn.com
# MOMO_TARGET_ENV=mtnghana

# ---- Telecel Cash + AirtelTigo Money (manual) ----
# MTN above is automatic. For Telecel and AirtelTigo the customer sends money to one of these numbers
# and submits the transaction ID; you confirm it with "Mark paid" in the admin dashboard.
# Comma-separated. These are the defaults if left unset.
MANUAL_PAY_NUMBERS=0538927692,0201753511

# ---- Store settings ----
FREE_DELIVERY_THRESHOLD=200
DELIVERY_FEE=15
DEFAULT_DELIVERY_AREA=Koforidua
